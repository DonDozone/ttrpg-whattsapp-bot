QUERY_SERVICE_URL=http://localhost:3000
# GROUP_JID=120363xxxxxxxxxx@g.us

# Push-Benachrichtigung bei ungültiger Auth (ntfy.sh-Format, optional).
# Topic frei wählbar, aber nicht erratbar — ntfy.sh-Topics sind öffentlich.
# NOTIFY_URL=https://ntfy.sh/pnp-wiki-bot-xxxxxxxx

# Dead-man's switch: wird alle 5 Min. gepingt, solange die Verbindung steht.
# Bleibt der Ping aus, alarmiert der Dienst (healthchecks.io, Uptime Kuma Push).
# HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Spieltag-Umfrage: sonntags ab POLL_HOUR an GROUP_JID, für die Woche in 8 Tagen.
# Mit POLL_ADMIN fragt der Bot vorher diese Nummer im Privatchat; die Umfrage
# geht erst nach der Antwort `ja` (oder `ja 43` für eine andere KW) raus.
# Manuell nachholen/testen per WhatsApp: `!umfrage` oder `!umfrage 41` (KW).
# POLL_ADMIN=49151xxxxxxxx
# POLL_HOUR=12
# POLL_TIMEZONE=Europe/Berlin

# Foundry-Schalter: `!foundry status|asche|v14` per WhatsApp (Privatchat oder Gruppe).
# Der Schalter-Dienst läuft auf demselben Host (network_mode: host).
# Ohne SWITCH_TOKEN ist der Befehl deaktiviert. Echte Werte nur in der .env.
# SWITCH_URL=http://127.0.0.1:8090
# SWITCH_TOKEN=
# Telefonnummern, die umschalten dürfen, kommagetrennt (nur Ziffern zählen).
# FOUNDRY_ADMINS=49151xxxxxxxx,49160xxxxxxxx
